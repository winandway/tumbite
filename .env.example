# Copia este archivo como .env y llena los valores. Nunca se commitea el .env.
# Servidor (van en el panel de YaDominios Cloud → Variables de entorno)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TURNSTILE_SECRET_KEY=
# Correos de las cuentas de prueba de los revisores de Apple y Google (separados por coma)
CORREOS_REVISOR=
# Apps (públicas, pueden ir al teléfono)
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

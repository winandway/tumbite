{
  "expo": {
    "name": "Divoox",
    "slug": "tumbite-cliente",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.windoce.tumbite",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Divoox uses your location to show nearby restaurants and to deliver your order.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "NSMotionUsageDescription": "Divoox may use your phone’s motion sensors to turn the map toward the direction you are facing."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F20D20",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.windoce.tumbite",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "PON_AQUI_LA_LLAVE_DE_GOOGLE_MAPS"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "tumbite-cliente",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Divoox uses your photos so you can attach a picture when you report a wrong or damaged item.",
          "cameraPermission": "Divoox uses the camera so you can photograph a wrong or damaged item when you report a problem with your order.",
          "microphonePermission": false
        }
      ],
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Divoox uses your location to show nearby restaurants and to deliver your order.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#F20D20",
          "defaultChannel": "pedidos",
          "sounds": ["./assets/sonidos/aviso.wav"]
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.tumbite.cliente",
          "enableGooglePay": true
        }
      ],
      "../../plugins/escenas-ios"
    ],
    "description": "Food delivery in Miami. Order from local restaurants and track your driver live.",
    "owner": "windoce-llc",
    "experiments": {
      "baseUrl": "/app"
    },
    "locales": {
      "es": "./idiomas/es.json"
    },
    "extra": {
      "sonidoAvisos": "aviso.wav",
      "eas": {
        "projectId": "0f62355b-be8a-44a8-b4b4-098976dc8f90"
      }
    }
  }
}

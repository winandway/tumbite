{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://divoox.com"
      },
      "node": "24.15.0"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://divoox.com"
      },
      "android": {
        "buildType": "apk"
      },
      "node": "24.15.0"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://divoox.com"
      },
      "node": "24.15.0"
    },
    "pruebas": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging.tumbite.com"
      },
      "android": {
        "buildType": "apk"
      },
      "node": "24.15.0"
    },
    "simulador": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging.tumbite.com"
      },
      "node": "24.15.0"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6829108108",
        "appleTeamId": "7KM9P6R682"
      }
    }
  }
}

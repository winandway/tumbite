{
  "expo": {
    "name": "Tumbite Restaurants",
    "slug": "tumbite-restaurante",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.windoce.tumbite.restaurants"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2B1B4E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.windoce.tumbite.restaurants"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "tumbite-restaurante",
    "plugins": ["expo-router", "expo-secure-store", "expo-audio"]
  }
}

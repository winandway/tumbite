{
  "expo": {
    "name": "Divoox Restaurants",
    "slug": "tumbite-restaurante",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.windoce.tumbite.restaurants",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Divoox uses your photos so you can add a photo of each dish to your menu.",
        "NSMotionUsageDescription": "Divoox may use your phone’s motion sensors when you take photos of your dishes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#101010",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.windoce.tumbite.restaurants",
      "permissions": [],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "tumbite-restaurante",
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#F20D20",
          "defaultChannel": "pedidos",
          "sounds": [
            "./assets/sonidos/alarma.wav",
            "./assets/sonidos/pedido_nuevo_largo.wav",
            "./assets/sonidos/dinero.wav",
            "./assets/sonidos/panico.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Divoox uses your photos so you can add a photo of each dish to your menu.",
          "cameraPermission": "Divoox uses the camera so you can take a photo of each dish for your menu.",
          "microphonePermission": false
        }
      ],
      "../../plugins/escenas-ios",
      "../../plugins/pantalla-vertical-opcional",
      "../../plugins/firma-ios-local",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#101010",
          "android": {
            "image": "./assets/splash-logo.png",
            "imageWidth": 240,
            "resizeMode": "contain",
            "backgroundColor": "#101010"
          },
          "ios": {
            "image": "./assets/splash-logo.png",
            "imageWidth": 240,
            "resizeMode": "contain",
            "backgroundColor": "#101010"
          }
        }
      ]
    ],
    "description": "Receive and manage your Divoox orders.",
    "owner": "windoce-llc",
    "experiments": {
      "baseUrl": "/restaurant"
    },
    "locales": {
      "es": "./idiomas/es.json"
    },
    "extra": {
      "sonidoAvisos": "alarma.wav",
      "canalesAvisos": {
        "pedido_nuevo": "pedido_nuevo_largo.wav",
        "avisos": "default",
        "dinero": "dinero.wav",
        "panico": "panico.wav"
      },
      "canalesSoloAndroid": true,
      "eas": {
        "projectId": "2fff4b85-0329-4ae1-bc8b-7dbd36d056ad"
      }
    }
  }
}

{
  "expo": {
    "name": "Divoox Restaurants",
    "slug": "tumbite-restaurante",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.windoce.tumbite.restaurants",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Divoox uses your photos so you can add a photo of each dish to your menu."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.windoce.tumbite.restaurants",
      "permissions": [],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "tumbite-restaurante",
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#FF3008",
          "defaultChannel": "pedidos",
          "sounds": ["./assets/sonidos/alarma.wav"]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Divoox uses your photos so you can add a photo of each dish to your menu.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "../../plugins/escenas-ios"
    ],
    "description": "Receive and manage your Divoox orders.",
    "owner": "windoce-llc",
    "experiments": {
      "baseUrl": "/restaurant"
    },
    "locales": {
      "es": "./idiomas/es.json"
    },
    "extra": {
      "sonidoAvisos": "alarma.wav"
    }
  }
}

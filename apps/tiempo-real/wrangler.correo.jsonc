// C-CAMILA-CORREO-HILO (20 nov 2026): la ENTRADA de correo de Camila en PRODUCCIÓN. Cloudflare Email
// Routing le entrega a este Worker lo que llega a las direcciones «support» y «soporte» de divoox.com (con o sin «+c…»), y él
// se lo pasa a POST /datos/gerente/camila/correo de divoox.com. Lo que Camila no toma va a BUZON_EQUIPO.
// Cuenta de Cloudflare: windoce1@gmail.com, SIEMPRE con HOME=~/.tumbite-cloudflare npx wrangler …
// Secreto (nunca aquí): GERENTE_SECRETO → `wrangler secret put GERENTE_SECRETO -c wrangler.correo.jsonc`.
// Las reglas de Email Routing NO van aquí (no se usa "addresses"): se crean a mano, una vez, y quedan
// escritas en docs/CAMILA-CORREO.md junto con cómo volver atrás en una emergencia.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "divoox-correo",
  "main": "src/correoEntrante.ts",
  "compatibility_date": "2026-09-01",
  "vars": { "BACKEND_URL": "https://divoox.com", "BUZON_EQUIPO": "soporte@windoce.com" },
  // La salida en hilo (src/correoSalida.ts): el servidor le pide a este Worker las respuestas que
  // llevan «In-Reply-To» y «References». Entra solo con el secreto del gerente.
  "workers_dev": true,
  "preview_urls": false,
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["support@divoox.com", "support@tumbite.com"],
    },
  ],
  "observability": { "enabled": true },
}

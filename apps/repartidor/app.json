{
  "expo": {
    "name": "Tumbite Driver",
    "slug": "tumbite-repartidor",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.windoce.tumbite.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Tumbite uses your location to show the route to the restaurant and the customer while you deliver.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Tumbite uses the camera to take a photo of your ID and your face when you verify your identity.",
        "CFBundleAllowMixedLocalizations": true
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#191919",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.windoce.tumbite.driver",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION", "CAMERA"],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "tumbite-repartidor",
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tumbite uses your location to offer you nearby orders and to show your route while you deliver.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#FF3008",
          "defaultChannel": "pedidos"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Tumbite uses the camera to take a photo of your ID and your face when you verify your identity.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "privacy": "public",
    "description": "Deliver with Tumbite and earn. Keep 100% of your tips.",
    "owner": "windoce-llc",
    "experiments": {
      "baseUrl": "/driver"
    },
    "locales": {
      "es": "./idiomas/es.json"
    }
  }
}

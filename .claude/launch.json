{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "panel",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@tumbite/panel"],
      "port": 5173
    },
    {
      "name": "servidor",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@tumbite/servidor", "--", "--port", "8787"],
      "port": 8787
    },
    {
      "name": "app-cliente-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8081"],
      "cwd": "apps/cliente",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:8787",
        "EXPO_NO_TELEMETRY": "1"
      },
      "port": 8081
    },
    {
      "name": "app-repartidor-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8082"],
      "cwd": "apps/repartidor",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:8787",
        "EXPO_NO_TELEMETRY": "1"
      },
      "port": 8082
    },
    {
      "name": "app-restaurante-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8083"],
      "cwd": "apps/restaurante",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:8787",
        "EXPO_NO_TELEMETRY": "1"
      },
      "port": 8083
    },
    {
      "name": "app-cliente-web-pruebas",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8081"],
      "cwd": "apps/cliente",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging.tumbite.com",
        "EXPO_NO_TELEMETRY": "1"
      },
      "port": 8081
    },
    {
      "name": "progreso",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8790"],
      "cwd": "progreso",
      "port": 8790
    },
    {
      "name": "panel-con-datos-de-pruebas",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@tumbite/panel"],
      "env": {
        "DATOS_URL": "https://staging.tumbite.com",
        "PUERTO_PANEL": "5183"
      },
      "port": 5183
    },
    {
      "name": "recorrido-servidor",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "-c",
        ".recorrido/wrangler.jsonc",
        "--port",
        "8790",
        "--persist-to",
        ".recorrido/estado"
      ],
      "port": 8790
    },
    {
      "name": "recorrido-stripe-simulado",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/recorrido/stripe-simulado.mjs"],
      "port": 12111
    },
    {
      "name": "recorrido-twilio-simulado",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/recorrido/twilio-simulado.mjs"],
      "port": 12112
    }
  ]
}
